---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

// Filtramos los posts por idioma si tu colección lo permite, 
// o simplemente cargamos los que correspondan al blog
const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

const isEn = true;
---

<Layout lang="en">
  <Header />
  <main id="main-content" data-layout="index" class="app-layout container mx-auto px-4 max-w-7xl">
    
    <section id="hero" class="flex flex-col-reverse lg:flex-row items-center justify-between py-12 lg:py-24 border-b border-border gap-12 lg:gap-20">
      
      <div class="lg:w-5/12 text-center lg:text-left">
        <h1 class="text-4xl font-bold sm:text-6xl leading-tight">
          Technical Leadership & Software Architecture
        </h1>
        
        <p class="mt-8 text-xl leading-relaxed opacity-90">
          Hi! I'm <strong>Livingstone Cano</strong>. Senior Software Engineer and Project Lead in Madrid. 
          With over 15 years of experience, I specialize in building scalable systems using 
          <strong> .NET 9/10</strong> and Clean Architecture.
        </p>

        <div class="mt-10 flex flex-col sm:flex-row items-center gap-6 justify-center lg:justify-start">
          <LinkButton
            href="/en/experience"
            class="bg-accent text-slate-950 px-8 py-4 rounded-xl font-bold hover:scale-105 transition-all shadow-lg shadow-accent/20"
          >
            View Journey
          </LinkButton>
          <Socials />
        </div>
      </div>

      <div class="relative lg:w-7/12 flex justify-center lg:justify-end">
        <div class="absolute inset-0 bg-accent/10 rounded-full blur-[120px] animate-pulse"></div>
        <div class="relative">
          <img 
            src="/me-avatar.png" 
            alt="Livingstone Cano" 
            class="relative z-10 w-80 h-80 md:w-[500px] md:h-[500px] lg:w-[680px] lg:h-[680px] object-contain drop-shadow-[0_35px_60px_rgba(34,197,94,0.35)] transition-transform duration-700 hover:scale-105"
          />
        </div>
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section id="featured" class="pt-16 pb-8 border-b border-border">
          <h2 class="text-3xl font-bold tracking-tight mb-8">Featured Articles</h2>
          <ul>
            {featuredPosts.map(post => (
              <Card variant="h3" {...post} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-16 pb-8">
          <h2 class="text-3xl font-bold tracking-tight mb-8">Recent Posts</h2>
          <ul>
            {recentPosts.map(
              (post, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...post} />
            )}
          </ul>
        </section>
      )
    }

    <div class="my-12 text-center">
      <LinkButton 
        href="/en/posts/"
        class="group inline-flex items-center gap-1 transition-all text-accent font-semibold text-lg"
      >
        View All Posts
        <IconArrowRight class="inline-block transition-transform group-hover:translate-x-1" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  img {
    animation: float 6s ease-in-out infinite;
  }
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-20px); }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/en/");
    }
  });
</script>